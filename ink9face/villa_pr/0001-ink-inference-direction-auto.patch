+def read_segment_reverse_layers(*paths: str | Path | None) -> tuple[bool | None, str | None]:
+    """Explicit per-segment layer order: the first 'reverse_layers' key found in metadata.json / meta.json inside a
+    given segment directory, or next to a given .zarr.  Returns (value, source) or (None, None)."""
+    for path in paths:
+        if path is None or is_url_like_path(path):
+            continue
+        path = Path(path)
+        directories = (path, path.parent) if path.suffix == ".zarr" else (path,)
+        for directory in directories:
+            for name in SEGMENT_METADATA_NAMES:
+                candidate = directory / name
+                if not candidate.is_file():
+                    continue
+                try:
+                    payload = json.loads(candidate.read_text())
+                except (OSError, ValueError):
+                    continue
+                if isinstance(payload, dict) and "reverse_layers" in payload:
+                    value = _as_bool(payload["reverse_layers"])
+                    if value is not None:
+                        return value, str(candidate)
+    return None, None
+
+
+def resolve_auto_direction(*paths: str | Path | None) -> str:
+    """Resolve --direction auto for one segment.
+
+    Explicit per-segment metadata ('reverse_layers') wins.  Otherwise use the anti-normal rule: feed the layers
+    reversed relative to the VC3D normal, i.e. 'reverse' for surface volumes rendered by vc_render_tifxyz (layer
+    index increasing along +n).  The rule is an empirical convention of the organizers' tifxyz meshes and the public
+    9um models trained on them; meshes from another tracer, or with a transposed / mirrored grid, flip +n.
+    """
+    value, source = read_segment_reverse_layers(*paths)
+    if value is not None:
+        direction = "reverse" if value else "forward"
+        if direction != "reverse":
+            LOGGER.warning(
+                "direction=auto: segment metadata %s sets reverse_layers=%s; using %s although the anti-normal rule "
+                "would use reverse",
+                source,
+                value,
+                direction,
+            )
+        else:
+            LOGGER.info("direction=auto: segment metadata %s sets reverse_layers=true -> reverse", source)
+        return direction
+    LOGGER.info("direction=auto: no reverse_layers in segment metadata -> reverse (anti-normal rule)")
+    return "reverse"
+
