diff -ruN a/ink-detection/koine_machines/inference/tests/test_direction_auto.py b/ink-detection/koine_machines/inference/tests/test_direction_auto.py
--- a/ink-detection/koine_machines/inference/tests/test_direction_auto.py
+++ b/ink-detection/koine_machines/inference/tests/test_direction_auto.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from koine_machines.inference.infer import (
+    parse_args,
+    resolve_auto_direction,
+    resolve_run_directions,
+)
+
+
+def _segment(tmp_path: Path, metadata: dict | None) -> Path:
+    segment = tmp_path / "20250611132918-z_dbg_gen_00302_inp_hr"
+    (segment / "layers.zarr").mkdir(parents=True)
+    if metadata is not None:
+        (segment / "metadata.json").write_text(json.dumps(metadata))
+    return segment
+
+
+def test_auto_defaults_to_reverse_without_metadata(tmp_path: Path) -> None:
+    segment = _segment(tmp_path, None)
+    assert resolve_auto_direction(segment, segment / "layers.zarr") == "reverse"
+    assert resolve_run_directions("auto", segment) == ("reverse",)
+
+
+@pytest.mark.parametrize("value, expected", [(True, "reverse"), (False, "forward"), ("false", "forward")])
+def test_auto_honours_explicit_segment_metadata(tmp_path: Path, value, expected: str) -> None:
+    segment = _segment(tmp_path, {"reverse_layers": value})
+    assert resolve_auto_direction(segment) == expected
+    # the metadata next to the zarr is found from the zarr path too
+    assert resolve_auto_direction(segment / "layers.zarr") == expected
+
+
+def test_auto_ignores_urls_and_unrelated_metadata(tmp_path: Path) -> None:
+    segment = _segment(tmp_path, {"scale": [0.05, 0.05]})
+    assert resolve_auto_direction("s3://bucket/seg/layers.zarr", segment) == "reverse"
+
+
+def test_existing_directions_unchanged() -> None:
+    assert resolve_run_directions("forward") == ("forward",)
+    assert resolve_run_directions("reverse") == ("reverse",)
+    assert resolve_run_directions("both") == ("forward", "reverse")
+
+
+@pytest.mark.parametrize("flag, expected", [("auto", "auto"), ("true", "reverse"), ("false", "forward")])
+def test_reverse_layers_shorthand(flag: str, expected: str) -> None:
+    args = parse_args(["in.zarr", "ckpt.pth", "out.tif", "--reverse_layers", flag])
+    assert args.direction == expected
+    assert parse_args(["in.zarr", "ckpt.pth", "out.tif"]).direction == "forward"
+
+
+def test_reverse_layers_conflict_is_an_error() -> None:
+    with pytest.raises(SystemExit):
+        parse_args(["in.zarr", "ckpt.pth", "out.tif", "--direction", "forward", "--reverse_layers", "true"])
